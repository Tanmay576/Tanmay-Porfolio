rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Resume and public certificates can be read publicly if shared, or authenticated owner
    match /users/{userId}/resume/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId}/certificates/{allPaths=**} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    // STRICTLY PRIVATE ACADEMIC VAULT DOCUMENTS
    // Only the owner who uploaded can read or write
    match /users/{userId}/documents/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
